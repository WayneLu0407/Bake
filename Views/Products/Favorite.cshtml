@model IEnumerable<Bake.ViewModel.WishListViewModel>
@inject Bake.Data.BakeContext context
@{
	ViewBag.Title = "我的關注商品";
}

<div class="tables-wrapper">
	<div class="">
		<div class="row">
			<div class="col-lg-12">
				<div class="card-style mb-30">
					<div id="tableFavorite">
						<div class="table-responsive ">
							<h1 class="text-center">我的關注商品</h1>
							<table id="favoriteTable" class="table">
								<thead class="text-center">
									<tr>
										<th>
											<h6>商品連結</h6>
										</th>
										<th>
											<h6>商品名稱</h6>
										</th>
										<th>
											<h6>價格</h6>
										</th>
										<th>
										</th>
									</thead>
									<tbody class="text-center">
										@foreach (var item in Model)
										{
											<tr>
												<td>
													<a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">
													<img src="@Html.DisplayFor(modelItem=>item.ImagePath)" alt="商品圖片" style="width:150px;" />
													</a>
												</td>
												<td>
													@Html.DisplayFor(modelItem=>item.Name)
												</td>
												<td>
													@Html.DisplayFor(modelItem=>item.Price)
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	@section Scripts {
		<script>

		</script>
	}