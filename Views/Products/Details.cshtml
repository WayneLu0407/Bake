@model Bake.ViewModel.Products.ProductDetailsViewModel
<div id="product" v-cloak>
    @Html.AntiForgeryToken()
    <div class="container-fluid  border-bottom">
            <div class="row py-3 justify-content-center">
                <div class="d-flex  justify-content-center align-items-center　">
                    <nav class="main-menu d-flex navbar navbar-expand-lg">
                        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar"
                                aria-controls="offcanvasNavbar">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                            <div class="offcanvas-header justify-content-center">
                                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                            </div>
                            <div class="offcanvas-body">
                                <ul class="navbar-nav   menu-list list-unstyled d-flex gap-md-3 mb-0">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index" asp-route-category="1">法式甜點</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index" asp-route-category="2">餅乾</a>
                                </li>
                                <li class="nav-item active">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index" asp-route-category="3">蛋糕</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index"asp-route-category="4">布丁</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index" asp-route-category="5">麵包</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index" asp-route-category="6">泡芙</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index" asp-route-category="7">甜甜圈</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index" asp-route-category="8">巧克力</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index" asp-route-category="9">糖果</a>
                                </li>
                            </ul>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
<main class="container">
    
    
    <!-- 載入中的佔位畫面 -->
    <section v-if="loading"></section>

    <section v-if="notFound" class="text-center py-5">
        <h3>此商品目前無法顯示</h3>
        <p class="text-muted">商品可能已下架或店鋪暫停營業</p>
        <a href="/Products/Index" class="btn btn-warning">回到商品列表</a>
    </section>
    <template v-if="!notFound && !loading">
        <nav aria-label="breadcrumb" class="my-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">首頁</a></li>
                <li class="breadcrumb-item"><a :href="'/Products/Index?category='+product.categoryId">{{ product.categoryName }}</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ product.productName }}</li>
            </ol>
        </nav>
        <!-- 商品主區 -->
        <section class="row g-5 mb-5" style="background-image: url('/images/background-pattern.jpg'); background-size: cover; background-position: center;">
            <!-- 左：圖片 -->
            <div class="col-12 col-lg-6 d-flex">
                <div id="carouselExampleFade" class="carousel slide carousel-fade w-100">
                    <div class="carousel-inner  h-100" style="min-height: 400px;">
                        <div class="carousel-item active h-100">
                            <img :src="product.productImage" :alt="product.productName" class="tab-image w-100 h-100" style="object-fit: cover;" alt="...">
                        </div>
                    </div>
                </div>
            </div>
            <!-- 右：商品資訊 -->
            <div class="col-12 col-lg-6 d-flex flex-column gap-3">
                <!-- 品牌名 + 商品標題 -->
                <div>
                    <p class="qty mb-1">{{product.shopName }}</p>   <!-- FoodMart .qty = 小字灰色 -->
                    <h1 class="fs-2 mb-0">{{ product.productName }}</h1>
                </div>

                <!-- 售價 -->
                <div class="d-flex flex-column gap-2">
                        <del v-if="salePrice(product.productPrice, product.productDiscount)" class="text-muted small">
                            NT${{ product.productPrice }}
                        </del>
                        <span class="fs-1 fw-bold" style="color: #e02020;">NT${{ salePrice(product.productPrice, product.productDiscount) || product.productPrice }}</span>
                </div>

                <!-- 數量 -->
                <div>
                        <p class="qty mb-1">數量<span class="text-muted small">(庫存：{{ product.productQuantity }} 件)</span></p>
                    <div class="input-group product-qty" style="width: 140px;">
                        <span class="input-group-btn">
                            <button type="button" class="quantity-left-minus btn btn-danger btn-number"
                                @@click.prevent="product.qty = Math.max(1, product.qty - 1)">
                                <svg width="16" height="16"><use xlink:href="#minus"></use></svg>
                            </button>
                        </span>
                        <input type="number" class="form-control input-number text-center"
                                v-model.number="product.qty"
                                   min="1" :max="product.productQuantity"
                            @@change="product.qty = Math.min(product.productQuantity, Math.max(1, product.qty || 1))">
                        <span class="input-group-btn">
                            <button type="button" class="quantity-right-plus btn btn-success btn-number"
                                    @@click.prevent="product.qty = Math.min(product.productQuantity, product.qty + 1)">
                                <svg width="16" height="16"><use xlink:href="#plus"></use></svg>
                            </button>
                        </span>
                    </div>
                </div>

                <!-- 按鈕組 -->
                <div class="d-flex flex-column gap-2 mt-2">
                    <!-- FoodMart .btn-primary -->
                    <button class="btn btn-primary py-3 w-100" style="color: #e02020;" @@click.prevent="addCart(product)">放入購物車</button>
                    <!-- FoodMart .btn-outline-light -->
                        <button class="btn btn-light py-3 w-100" :class="{'is-active' : product.isFavorited}" @@click.prevent="toggleFavorite(product)" >
                            {{ product.isFavorited ? '已加入最愛' : '加入最愛' }}
                        </button>
                </div>
            </div>
        </section>

        <section class="row g-5 mb-5">

            <!-- 左：商品介紹 -->
            <div class="col-12 col-lg-6">
                <div class="section-heading">商品介紹</div>
                <p class="lh-lg">
                    {{product.productDescription}}
                </p>
            </div>

            <!-- 右：品牌側欄 -->
            <aside class="col-12 col-lg-6">

                <!-- 標題列 -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="section-heading mb-0 border-0 pb-0">關於品牌</div>
                    <!-- FoodMart .btn-outline-light -->
                    <a :href="'/Shop/' + product.userId"
                           class="btn btn-outline-primary">
                        來去逛逛</a>
                    </a> 
                    <a :href="'/Chat/StartChat?targetId=' + product.userId"
                       class="btn btn-outline-primary">
                        聯絡賣家
                    </a>
                </div>

                <!-- 品牌卡（FoodMart .brand-item） -->
                <div class="brand-item d-flex align-items-center gap-3 mb-3">
                    <img :src="product.shopImg" alt="品牌Logo" class="review-avatar" style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%;" />
                    <div>
                        <p class="fw-bold mb-0" style="color:var(--dark-color);">{{product.shopName}}</p>
                        <p class="qty mb-0">台灣</p>
                    </div>
                </div>

                <!-- 品牌資訊 -->
                <div class="brand-stats">
                    <p>上次上線：<strong>1～3 天前</strong></p>
                    <p>回應率：<strong>100%</strong></p>
                    <p>回應速度：<strong>1 日內</strong></p>
                    <p>平均出貨速度：<strong>一週內</strong></p>
                </div>
            </aside>
        </section>

        <!-- =========================================
               商品資訊（table）
          ========================================= -->

        <section class="mb-5">
            <div class="section-heading">商品資訊</div>
            <table class="info-table w-100">
                <tbody>
                    <tr><td>賞味期限</td><td>{{product.shelfLifeNote}}</td></tr>
                    <tr><td>內容物</td><td>{{product.ingredient}}</td></tr>
                    <tr><td>內容量</td><td>{{product.netWeight}}</td></tr>
                </tbody>
            </table>
        </section>

        <!-- =========================================
               購買評價
          ========================================= -->

        @await Html.PartialAsync("_ProductReviewsPartial", Model.Reviews)

        <!-- =========================================
             推薦商品
             FoodMart .product-item 卡片
             Bootstrap row g-3 排列
        ========================================= -->

        <section class="py-5 overflow-hidden">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">

                        <div class="section-header d-flex justify-content-between">

                            <h2 class="section-title">推薦商品</h2>

                            <div class="d-flex align-items-center">
                                <a class="btn-link text-decoration-none" asp-area="" asp-controller="Products" asp-action="Index">查看更多</a>
                                <div class="swiper-buttons">
                                    <button class="swiper-prev products-carousel2-prev btn btn-primary">❮</button>
                                    <button class="swiper-next products-carousel2-next btn btn-primary">❯</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">

                        <div class="products-carousel2 swiper">
                            <div class="swiper-wrapper">

                                <!-- 單一商品 — 複製此區塊重複使用 -->
                                <div class="swiper-slide" v-for="product in productsByDiscount.slice(0, 10)" :key="product.productId">
                                    <div class="product-item">
                                        <span v-if="discountLabel(product.productDiscount)" class="badge bg-success position-absolute m-3">{{ discountLabel(product.productDiscount) }}</span>
                                        <a href="#" class="btn-wishlist" :class="{'is-active' : product.isFavorited}" @@click.prevent="toggleFavorite(product)">
                                            <iconify-icon :key="product.isFavorited"
                                                          :icon="product.isFavorited ? 'ph:heart-fill' : 'ph:heart'"
                                                          :style="{ color: product.isFavorited ? '#ff4d4d' : 'inherit' }"
                                                          width="24">
                                            </iconify-icon>
                                        </a>
                                        <figure class="mb-3">
                                            <a :href="'/Products/Details/' + product.productId" title="Product Title">
                                                <img :src="product.productImage" :alt="product.productName" class="tab-image">
                                            </a>
                                        </figure>
                                        <h3>{{product.productName }}</h3>
                                        <span class="qty">{{ product.shopName }}</span>
                                        <span class="rating">
                                            <iconify-icon icon="ph:star-fill" style="color:#FFC43F; font-size:16px; vertical-align:-2px;"></iconify-icon>
                                            {{ product.productRating }}
                                        </span>
                                        <div class="d-flex align-items-center gap-2">
                                            <del v-if="salePrice(product.productPrice, product.productDiscount)" class="text-muted small">
                                                NT${{ product.productPrice }}
                                            </del>
                                            <span class="price">NT${{ salePrice(product.productPrice, product.productDiscount) || product.productPrice }}</span>

                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="input-group product-qty">
                                                <span class="input-group-btn">
                                                    <button type="button" class="quantity-left-minus btn btn-danger btn-number" @@click.prevent="product.qty = Math.max(1, product.qty - 1)">
                                                        <svg width="16" height="16"><use xlink:href="#minus"></use></svg>
                                                    </button>
                                                </span>
                                                <input type="text" class="form-control input-number"
                                                       v-model.number="product.qty"
                                                       min="1" :max="product.productQuantity"
                                                       style="min-width: 40px !important; padding: 2px 4px !important; text-align: center;"
                                                @@change="product.qty = Math.min(product.productQuantity, Math.max(1, product.qty||1))">
                                                <span class="input-group-btn">
                                                    <button type="button" class="quantity-right-plus btn btn-success btn-number" @@click.prevent="product.qty = Math.min(product.productQuantity, product.qty + 1)">
                                                        <svg width="16" height="16"><use xlink:href="#plus"></use></svg>
                                                    </button>
                                                </span>
                                            </div>
                                            <a href="#" class="btn btn-danger btn-sm w-20 mt-1" @@click.prevent="addCart(product)">加入購物車 <iconify-icon icon="uil:shopping-cart"></a>
                                        </div>
                                    </div>
                                </div>
                                <!-- / 單一商品 -->
                            </div>
                        </div>
                        <!-- / products-carousel -->
                    </div>
                </div>
            </div>
        </section>
    </template>
    </main>
</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script>
        const app=Vue.createApp({
            mixins: [CartMixin],
            data(){
                return{
                    products: [],
                    product: {},
                    loading: true,
                    sortBy: 'productsByDiscount',
                    notFound: false
                }
            },
            methods: {
                discountLabel(discount) {
                if (!discount || discount <= 0) return null
                return `-${Math.round(discount * 100)}%`   // 0.20 → "-20%"
                },
            salePrice(price, discount) {
                if (!discount || discount <= 0) return null
                return Math.round(price*(1 - discount))  //  100 * (1-0.15) = 85
                },
                async toggleFavorite(product){
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    try {
                        const response = await fetch('/Products/ToggleFavorite', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ 
                                productId: product.productId,
                                __RequestVerificationToken: token
                            })
                        });
                        const res = await response.json();

                        if (res.success) {
                            // 直接更新物件屬性，Vue 3 會自動感應
                            product.isFavorited = res.isFavorited;
            
                            Swal.fire({
                            icon: "success",
                            title: res.message,
                            showConfirmButton: false,
                            timer: 1500
                        });
                        } else {
                            Swal.fire({
                            icon: "warning",
                            title: "提示",
                            text: res.message
                        }).then(() => {
                            if (res.message.includes("登入")) {
                                window.location.href = '/Home/Login';
                            }
                            });
                        }
                    } catch (err) {
                            console.error("收藏失敗", err);
                    }
                }
            },
            computed:{

                 productsByRating(){
                 return [...this.products].sort((a,b)=> b.productRating - a.productRating)
                 },
                 productsByDate(){
                 return [...this.products].sort((a,b)=> new Date(b.productDate) - new Date(a.productDate))
                 },
                 productsByDiscount(){
                 return [...this.products].sort((a,b)=> b.productDiscount - a.productDiscount)
                 },
                 categoryName(){
                 const map = {
                        1: '法式甜點',
                        2: '餅乾',
                        3: '蛋糕',
                        4: '布丁',
                        5: '麵包',
                        6: '泡芙',
                        7: '甜甜圈',
                        8: '巧克力',
                        9: '糖果'
                     }
                     return map [this.product.categoryId] || null
                 }
            },
            async mounted() {
                // 從網址 /Products/Details/3 取出最後的數字 3
                const id = window.location.pathname.split('/').pop()

                // 抓單筆商品（頁面主角）
                const res1 = await fetch(`/api/Product/GetById/${id}`)

                if(!res1.ok){
                    this.notFound = true
                    this.loading = false
                    return
                }

                this.product = await res1.json()

                // 抓全部商品（推薦商品輪播）
                const res2 = await fetch('/api/Product/Get')
                const data = await res2.json()
                this.product.qty = 1; //下拉式選單初始值為1
                this.products = data.map(p => ({
                    ...p,
                    qty: 1,  //為每個推薦商品加上初始數量為1
                    isFavorited: p.isFavorited || false
                }))

                this.loading = false

                // 等 Vue 把 DOM 更新完再通知 Swiper
                this.$nextTick(() => {
                    const el = document.querySelector('.products-carousel2')
    
                    // 如果已有 swiper 實例，先銷毀
                    if (el?.swiper) {
                        el.swiper.destroy(true, true)
                    }

                    // 重新初始化
                    new Swiper('.products-carousel2', {
                        slidesPerView: 4,
                        spaceBetween: 20,
                        navigation: {
                        prevEl: '.products-carousel2-prev',
                        nextEl: '.products-carousel2-next',
                    },
                    breakpoints: {
                        0:    { slidesPerView: 1 },
                        576:  { slidesPerView: 2 },
                        992:  { slidesPerView: 3 },
                        1200: { slidesPerView: 4 },
                    }
                    })
                })
            }
        });
        app.mount('#product');
    </script>

}