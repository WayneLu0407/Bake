@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "404 - 頁面不存在";
}

<!-- ========== Error section start ========== -->
<section style="min-height: calc(100vh - 320px); display: flex; align-items: center;">
    <div class="container-fluid">
        <!-- ========== error-cards-wrapper start ========== -->
        <div class="card-style text-center">
            <div class="error-box">
                <img class="mx-auto m-5" src="~/seller_assets/images/error.svg" alt="error img">
                    <h2 class="fw-700 mb-15">頁面不存在</h2>
                    <p class="text-sm mb-25">
                        請透過客服信箱：support@sweetstack.com 聯繫我們，將有專人盡快回覆您！
                    </p>
                </div>
            </div>
            <!-- ========== error-cards-wrapper end ========== -->
        </div>
        <!-- end container -->
    </section>
<!-- ========== Error section end ========== -->
