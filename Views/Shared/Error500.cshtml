@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "500 - 系統錯誤";
}

<!-- ========== Error section start ========== -->
<section style="min-height: calc(100vh - 320px); display: flex; align-items: center;">
    <div class="container-fluid">
        <!-- ========== error-cards-wrapper start ========== -->
        <div class="card-style text-center">
            <div class="error-box">
                <img class="mx-auto mb-20" src="~/seller_assets/images/error500.jpg" alt="error img" style="width:40%;">
                    <h3 class="fw-700 mb-15">
                        系統發生錯誤，請稍後再試</h1>
                        <p class="text-sm mb-25">
                            請透過客服信箱：support@sweetstack.com 聯繫我們，將有專人盡快回覆您！
                        </p>
                    </div>
                </div>
                <!-- ========== error-cards-wrapper end ========== -->
            </div>
            <!-- end container -->
        </section>
<!-- ========== Error section end ========== -->
