@model Bake.ViewModel.EventCreateViewModel

@{
    ViewData["Title"] = "新增活動";
}

@section Styles {
    <style>
        .event-create-wrap {
            max-width: 760px;
            margin: 0 auto;
        }

        .event-create-card {
            border: 0;
            border-radius: 20px;
            background: #f7efe9;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }

        .section-title {
            font-weight: 700;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-weight: 600;
        }

        .organizer-box {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.5rem;
        }

        .organizer-avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
            background: #ddd;
            flex-shrink: 0;
        }

        .organizer-avatar-placeholder {
            border: 1px solid #cfcfcf;
            background: #d9d9d9;
        }

        .form-control::placeholder {
            color: #adb5bd; 
        }

        .preview-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
            gap: 12px;
            margin-top: 12px;
        }

        .preview-item {
            position: relative;
            aspect-ratio: 1 / 1;
            border-radius: 12px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #ddd;
        }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .preview-empty {
            min-height: 110px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px dashed #bbb;
            border-radius: 12px;
            background: #fff;
            color: #777;
            margin-top: 12px;
        }

        .text-danger{
            color: indianred !important;
        }
    </style>
}

<div class="container py-4 py-md-5">
    <div class="event-create-wrap">
        <div class="card event-create-card">
            <div class="card-body p-3 p-md-4 p-lg-5">
                <h2 class="section-title">新增活動</h2>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="organizer-box">
                    @if (!string.IsNullOrWhiteSpace(Model.OrganizerAvatarUrl))
                    {
                        <img src="@Model.OrganizerAvatarUrl" alt="主辦人頭像" class="organizer-avatar" />
                    }
                    else
                    {
                        <div class="organizer-avatar organizer-avatar-placeholder"></div>
                    }

                    <div>
                        <div class="fw-bold">主辦人</div>
                        <div>@Model.OrganizerName</div>
                    </div>
                </div>

                <form id="eventForm" asp-action="NewEvent" asp-controller="Post" method="post"  enctype="multipart/form-data" novalidate>
                @* <form id="eventForm" asp-action="NewEvent" asp-controller="Post" method="post" onsubmit="return confirm('確認發起活動?')" enctype="multipart/form-data" novalidate> *@
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" type="date" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="StartTime" class="form-label"></label>
                            <input asp-for="StartTime" class="form-control" type="time" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="EndTime" class="form-label"></label>
                            <input asp-for="EndTime" class="form-control" type="time" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="LocationCity" class="form-label"></label>
                        <input asp-for="LocationCity" class="form-control" />
                        <span asp-validation-for="LocationCity" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <label asp-for="LocationAddress" class="form-label"></label>
                        <input asp-for="LocationAddress" class="form-control" />
                        <span asp-validation-for="LocationAddress" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <label asp-for="MaxParticipants" class="form-label"></label>
                            <input asp-for="MaxParticipants" class="form-control" type="number" data-val-number="請輸入有效的數字" />
                            <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" type="number" data-val-number="請輸入有效的數字" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <label asp-for="SignupStartDate" class="form-label"></label>
                            <input asp-for="SignupStartDate" class="form-control" type="date" />
                            <span asp-validation-for="SignupStartDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="SignupEndDate" class="form-label"></label>
                            <input asp-for="SignupEndDate" class="form-control" type="date" />
                            <span asp-validation-for="SignupEndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="KeywordsText" class="form-label fw-bold">
                            <i class="bi bi-tags-fill me-1"></i>活動關鍵字
                        </label>
                        <input asp-for="KeywordsText"
                               class="form-control"
                               placeholder="例如：新手友善, 食材團購, 基礎烘焙(請使用空格或逗號分開)" />
                        <span asp-validation-for="KeywordsText" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <label asp-for="EventTypeId" class="form-label"></label>
                        <select asp-for="EventTypeId" asp-items="Model.EventTypeOptions" class="form-select"></select>
                        <span asp-validation-for="EventTypeId" class="text-danger"></span>
                    </div>

                    <label asp-for="Photo" class="form-label"></label>
                    <input asp-for="Photo" id="PhotoInput" class="form-control" type="file" accept="image/*" />
                    <span asp-validation-for="Photo" class="text-danger"></span>

                    <div id="photoPreview" class="preview-grid"></div>
                    <div id="photoEmpty" class="preview-empty">請上傳一張活動照片</div>

                    <div class="mt-4">
                        <button type="button" id="btnShowModal" class="btn btn-warning w-100 fw-bold">建立活動</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* madel容器 *@
<div class="modal fade" id="confirmPublishModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border: none;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="confirmModalLabel">發佈確認</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pb-4">
                <p class="fs-5 fw-bold mb-2" style="color: #444;">發佈後將可能不能任意下架，是否確定發佈？</p>
                
                <p class="text-danger mb-0" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                    *若已有人報名，將無法更改活動狀態及時間、地點。
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="border-radius: 10px;">再檢查一遍</button>
                <button type="button" id="btnSubmitFinal" class="btn btn-warning px-4 fw-bold" style="border-radius: 10px;">確定發佈</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    $(function() {
        @* 取得jQuery物件 *@
        const $form = $("#eventForm");
        const $btnShowModal = $("#btnShowModal");
        const $btnSubmitFinal = $("#btnSubmitFinal");

        const $photoInput = $("#PhotoInput");
        const $previewWrap = $("#photoPreview");
        const $previewEmpty = $("#photoEmpty");

        // 2. 初始化Bootstrap Modal 物件
        const confirmModal = new bootstrap.Modal(document.getElementById('confirmPublishModal'));

        $btnShowModal.on("click", function() {
            if ($form.valid()) {
                confirmModal.show();
            } else {
                // 驗證失敗，滾動到第一個錯誤的地方
                const firstError = $(".text-danger:visible").first();
                if (firstError.length > 0) {
                    $([document.documentElement, document.body]).animate({
                        scrollTop: firstError.offset().top - 100
                    }, 200);
                }
            }
        });

        $btnSubmitFinal.on("click", function() {
            $form.submit();
        });

        $photoInput.on("change", function() {
            @*清空之前的預覽內容 *@
            $previewWrap.empty();

            const file = this.files && this.files[0];

            @* 檢查是否有檔案且為圖片 *@
            if (!file || !file.type.startsWith("image/")) {
                $previewEmpty.show().css("display", "flex"); 
                return;
            }

            @* 隱藏預設提示 *@
            $previewEmpty.hide();

            const reader = new FileReader();
            reader.onload = function(e) {
                @* 動態產生htnl結構 *@
                const $item = $("<div>").addClass("preview-item");
                const $img = $("<img>").attr("src", e.target.result);

                $item.append($img);
                $previewWrap.append($item);
            };
            reader.readAsDataURL(file);
        });

        @* 當輸入框失去焦點時，自動修剪前後空白 *@
        $('input[type="text"], textarea').on('blur', function () {
            $(this).val($.trim($(this).val()));
        });
    });
    </script>
}