
@{
    ViewData["Title"] = "交流分享區";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/PostIndexCss.css" />
}

<div id="posts-app" v-cloak>
    <!-- ========== 橘色標題橫幅 ========== -->
    <div class="community-banner">交流分享區</div>
    <!-- ========== 1. 頂部輪播 ========== -->
    <section class="py-3">
        <div class="container-fluid">
            <div class="banner-blocks">
                <div class="banner-ad large">
                    <div class="swiper hero-swiper">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide" style="background: url('/postimage/banner/banner1.jpg') no-repeat center / cover;">
                                <div class="w-100 d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 300px;text-shadow: 2px 2px 6px rgba(0,0,0,0.6);">
                                    <h5 class="categories mb-2 text-white">烘焙人的秘密基地</h5>
                                    <h2 class="text-white fw-bold">分享你的甜點故事</h2>
                                    <h5 class="text-white">食譜交流 · 活動揪團 · 找到和你一樣熱愛烘焙的人</h5>
                                </div>
                            </div>
                            <div class="swiper-slide" style="background: url('/postimage/banner/banner3.jpg') no-repeat center / cover;">
                                <div class="w-100 d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 300px;text-shadow: 2px 2px 6px rgba(0,0,0,0.6);">
                                    <h5 class="categories mb-2 text-white">不只是買賣，更是一個社群</h5>
                                    <h2 class="text-white fw-bold">一起烤 一起吃 一起玩</h2>
                                    <h5 class="text-white">發起手作工作坊 · 揪團嘗鮮 · 和烘焙同好面對面交流</h5>
                                </div>
                            </div>
                        </div>
                        <div class="swiper-pagination"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <div class="p-5">
        <!-- ========== 3. 搜尋列 + 按鈕 ========== -->
        <section class="px-4">
            <div class="container-fluid">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">
                    <!-- 搜尋 -->
                    <div class="post-search-bar position-relative flex-grow-1" id="search-app" v-cloak>
                        <input type="text" class="form-control" placeholder="搜尋文章" v-model="keyword" @@keyup.enter="goSearch" />
                        <button class="btn-search-icon" type="button" @@click="goSearch">
                            <svg width="20" height="20" viewBox="0 0 24 24"><use xlink:href="#search"></use></svg>
                        </button>
                    </div>
                    <!-- 按鈕 -->
                    <div class="d-flex gap-2">
                        <a asp-controller="Post" asp-action="PostList" class="btn btn-post-action">全部</a>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="PostArticle" asp-action="CreatePost" class="btn btn-post-action">新增貼文</a>
                            <a asp-controller="Post" asp-action="CreateActivity" class="btn btn-post-action">新增活動</a>
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- ========== 4. 最新貼文 ========== -->
        <section class="py-3 overflow-hidden">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="section-heading">最新貼文</h3>
                    <div class="swiper-buttons">
                        <button class="swiper-prev latest-post-prev btn btn-primary btn-sm">❮</button>
                        <button class="swiper-next latest-post-next btn btn-primary btn-sm">❯</button>
                    </div>
                </div>
                <div class="swiper latest-post-carousel">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide" v-for="post in latestPosts" :key="post.postId">
                            <a :href="'/Post/PostDetail/' + post.postId" class="text-decoration-none text-dark">
                                <div class="post-card">
                                    <img v-if="post.image" :src="post.image" :alt="post.title" class="card-thumb" />
                                    <div v-else class="card-thumb-placeholder"></div>
                                    <div class="card-body">
                                        <p class="card-title">{{ post.title }}</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========== 5. 熱門貼文 ========== -->
        <section class="py-3 overflow-hidden">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="section-heading">熱門貼文</h3>
                    <div class="swiper-buttons">
                        <button class="swiper-prev hot-post-prev btn btn-primary btn-sm">❮</button>
                        <button class="swiper-next hot-post-next btn btn-primary btn-sm">❯</button>
                    </div>
                </div>
                <div class="swiper hot-post-carousel">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide" v-for="post in hotPosts" :key="post.postId">
                            <a :href="'/Post/PostDetail/' + post.postId" class="text-decoration-none text-dark">
                                <div class="post-card">
                                    <img v-if="post.image" :src="post.image" :alt="post.title" class="card-thumb" />
                                    <div v-else class="card-thumb-placeholder"></div>
                                    <div class="card-body">
                                        <p class="card-title">{{ post.title }}</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========== 6. 熱門活動分類 ========== -->
        <section class="py-4">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="section-heading">熱門活動分類</h3>
                </div>
                <div class="row g-4">
                    <div class="col-3" v-for="cat in categories.filter(c=>c.eventTypeId!==0)" :key="cat.eventTypeId">
                            <a :href="'/Post/PostList?category=' + cat.eventTypeId" class="text-decoration-none text-dark">
                            <div class="category-icon-card text-center">
                                <div class="icon-circle">
                                    <i class="fa-solid" :class="cat.icon"></i>
                                </div>
                                <p class="mt-2 fw-bold mb-0">{{ cat.eventTypeName }}</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
        </section>

        <!-- ========== 7. 揪團中的活動（第一組） ========== -->
        <section class="py-3 overflow-hidden">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="section-heading">揪團中的活動</h3>
                    <div class="swiper-buttons">
                        <button class="swiper-prev group1-prev btn btn-primary btn-sm">❮</button>
                        <button class="swiper-next group1-next btn btn-primary btn-sm">❯</button>
                    </div>
                </div>
                <div class="swiper group1-carousel">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide" v-for="act in groupActivities1" :key="act.postId">
                            <a :href="'/Post/PostDetail/' + act.postId" class="text-decoration-none text-dark">
                                <div class="post-card">
                                    <img v-if="act.image" :src="act.image" :alt="act.title" class="card-thumb" />
                                    <div v-else class="card-thumb-placeholder"></div>
                                    <div class="card-body">
                                        <p class="card-title">{{ act.title }}</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts
{
    <script>
        const postsApp = Vue.createApp({
            data() {
                return {
                    keyword: '',
                    latestPosts: [],
                    hotPosts: [],
                    categories: [],
                    groupActivities1: [],
                    groupActivities2: [],
                }
            },
            async mounted() {
                // ---- 呼叫你的 API 拿資料（路徑請依實際後端調整） ----

                const results = await Promise.allSettled([
                    fetch('/api/PostApi/Latest').then(r=>r.json()),
                    fetch('/api/PostApi/Hot').then(r => r.json()),
                    fetch('/api/PostApi/EventTypes').then(r => r.json()),
                    fetch('/api/PostApi/GroupEvents').then(r => r.json()),
                ]);
                // 最新貼文
                if (results[0].status === 'fulfilled') {
                    this.latestPosts = results[0].value;
                } else { 
                 console.error('Latest失敗:',results[0].reason);
                }

                // 熱門貼文
                if (results[1].status === 'fulfilled') {
                    this.hotPosts = results[1].value;
                } else {
                    console.error('Hot 失敗:', results[1].reason);
                }


                // 熱門活動分類
                if (results[2].status === 'fulfilled') {
                    const iconMap = {
                        1: 'fa-cookie-bite',      // 手作實作
                        2: 'fa-comments',         // 經驗分享
                        3: 'fa-mug-hot',          // 品嚐聚會
                        4: 'fa-basket-shopping',  // 食材揪團
                    };
                    this.categories = results[2].value.map(c => ({
                        ...c,
                        icon: iconMap[c.eventTypeId] || 'fa-tag'
                    }));
                } else{ 
                    console.error('EventTypes 失敗:', results[2].reason);
                }

                // 揪團活動
                if (results[3].status === 'fulfilled') {
                    this.groupActivities1 = results[3].value;
                }else { 
                    console.error('EventTypes 失敗:', results[3].reason);
                }

                // ---- 等 DOM 更新後初始化所有 Swiper ----
                this.$nextTick(() => { this.initSwipers(); });
            },
            methods: {
                
                goSearch(){
                    if(this.keyword.trim()){
                        window.location.href = '/Post/PostList?keyword=' + encodeURIComponent(this.keyword.trim())
                    }
                },
                /** 統一初始化所有 Swiper（與首頁同樣的銷毀→重建模式） */
                initSwipers() {
                    const defaultBreak = {
                        0:    { slidesPerView: 2, spaceBetween: 12 },
                        768:  { slidesPerView: 3, spaceBetween: 20 },
                        992:  { slidesPerView: 4, spaceBetween: 24 },
                        1200: { slidesPerView: 5, spaceBetween: 28 },
                    }

                    const configs = [
                        {
                            sel: '.hero-swiper',
                            prev: null, next: null,
                            loop: true,
                            autoplay: { delay: 4000 },
                            pagination: { el: '.swiper-pagination', clickable: true },
                            breakpoints: { 0: { slidesPerView: 1 } }
                        },
                        { sel: '.latest-post-carousel',  prev: '.latest-post-prev',  next: '.latest-post-next' },
                        { sel: '.hot-post-carousel',     prev: '.hot-post-prev',     next: '.hot-post-next' },
                        {
                            sel: '.category-carousel',
                            prev: '.cat-prev', next: '.cat-next',
                            breakpoints: {
                                0:    { slidesPerView: 2, spaceBetween: 12 },
                                768:  { slidesPerView: 3, spaceBetween: 20 },
                                1200: { slidesPerView: 4, spaceBetween: 28 }
                            }
                        },
                        { sel: '.group1-carousel', prev: '.group1-prev', next: '.group1-next' },
                        { sel: '.group2-carousel', prev: '.group2-prev', next: '.group2-next' },
                    ]

                    configs.forEach(cfg => {
                        const el = document.querySelector(cfg.sel)
                        if (!el) return
                        if (el.swiper) el.swiper.destroy(true, true)

                        const opts = {
                            loop: cfg.loop || false,
                            speed: 500,
                            breakpoints: cfg.breakpoints || defaultBreak,
                        }
                        if (cfg.prev && cfg.next) {
                            opts.navigation = { prevEl: cfg.prev, nextEl: cfg.next }
                        }
                        if (cfg.autoplay) opts.autoplay = cfg.autoplay
                        if (cfg.pagination) opts.pagination = cfg.pagination

                        new Swiper(cfg.sel, opts)
                    })
                }
            },

        }).mount('#posts-app')
    </script>
}