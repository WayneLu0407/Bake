@model Bake.ViewModel.EventEditViewModel

@{
    ViewData["Title"] = "編輯活動";
}

@section Styles {
    <style>
        .event-create-wrap {
            max-width: 760px;
            margin: 0 auto;
        }

        .event-create-card {
            border: 0;
            border-radius: 20px;
            background: #f7efe9;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }

        .section-title {
            font-weight: 700;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-weight: 600;
        }

        .organizer-box {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.5rem;
        }

        .organizer-avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
            background: #ddd;
            flex-shrink: 0;
        }

        .organizer-avatar-placeholder {
            border: 1px solid #cfcfcf;
            background: #d9d9d9;
        }

        .form-control::placeholder {
            color: #adb5bd; 
        }

        .preview-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
            gap: 12px;
            margin-top: 12px;
        }

        .preview-item {
            position: relative;
            aspect-ratio: 1 / 1;
            border-radius: 12px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #ddd;
        }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .preview-empty {
            min-height: 110px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px dashed #bbb;
            border-radius: 12px;
            background: #fff;
            color: #777;
            margin-top: 12px;
        }

        .text-danger{
            color: indianred !important;
        }
    </style>
}

<div class="container py-4 py-md-5">
    <div class="event-create-wrap">
        <div class="card event-create-card">
            <div class="card-body p-3 p-md-4 p-lg-5">
                <h2 class="section-title">編輯活動</h2>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="organizer-box">
                    @if (!string.IsNullOrWhiteSpace(Model.OrganizerAvatarUrl))
                    {
                        <img src="@Model.OrganizerAvatarUrl" alt="主辦人頭像" class="organizer-avatar" />
                    }
                    else
                    {
                        <div class="organizer-avatar organizer-avatar-placeholder"></div>
                    }

                    <div>
                        <div class="fw-bold">主辦人</div>
                        <div>@Model.OrganizerName</div>
                    </div>
                </div>

                <form asp-action="EditEvent" asp-controller="Post" asp-route-postId="@Model.PostId" method="post" onsubmit="return confirm('確認更新活動?')" enctype="multipart/form-data" novalidate>
                    @Html.AntiForgeryToken()

                    @* 與編輯的Controller溝通用 *@
                    <input asp-for="PostId" type="hidden" />
                    <input asp-for="EventId" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    @if (Model.HasRegistrations)
                    {
                        <div class="alert alert-warning">
                            此活動已有報名資料，活動日期 / 時間 / 地點 / 名額 / 報名期間先暫時鎖定不可修改。
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" type="date" disabled="@(Model.HasRegistrations)" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="StartTime" class="form-label"></label>
                            <input asp-for="StartTime" class="form-control" type="time" disabled="@(Model.HasRegistrations)" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="EndTime" class="form-label"></label>
                            <input asp-for="EndTime" class="form-control" type="time" disabled="@(Model.HasRegistrations)" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="LocationCity" class="form-label"></label>
                        <input asp-for="LocationCity" class="form-control" disabled="@(Model.HasRegistrations)" />
                        <span asp-validation-for="LocationCity" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <label asp-for="LocationAddress" class="form-label"></label>
                        <input asp-for="LocationAddress" class="form-control" disabled="@(Model.HasRegistrations)" />
                        <span asp-validation-for="LocationAddress" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <label asp-for="MaxParticipants" class="form-label"></label>
                            <input asp-for="MaxParticipants" class="form-control" type="number" data-val-number="請輸入有效的數字" disabled="@(Model.HasRegistrations)" />
                            <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" type="number" data-val-number="請輸入有效的數字" disabled="@(Model.HasRegistrations) />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <label asp-for="SignupStartDate" class="form-label"></label>
                            <input asp-for="SignupStartDate" class="form-control" type="date" disabled="@(Model.HasRegistrations)" />
                            <span asp-validation-for="SignupStartDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="SignupEndDate" class="form-label"></label>
                            <input asp-for="SignupEndDate" class="form-control" type="date" disabled="@(Model.HasRegistrations)" />
                            <span asp-validation-for="SignupEndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="KeywordsText" class="form-label fw-bold">
                            <i class="bi bi-tags-fill me-1"></i>活動關鍵字
                        </label>
                        <input asp-for="KeywordsText"
                               class="form-control"
                               placeholder="例如：新手友善, 食材團購, 基礎烘焙(請使用空格或逗號分開)" />
                        <span asp-validation-for="KeywordsText" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <label asp-for="EventTypeId" class="form-label"></label>
                        <select asp-for="EventTypeId" asp-items="Model.EventTypeOptions" class="form-select"></select>
                        <span asp-validation-for="EventTypeId" class="text-danger"></span>
                    </div>

                    <label asp-for="Photo" class="form-label"></label>
                    <input asp-for="Photo" id="PhotoInput" class="form-control" type="file" accept="image/*" />
                    <span asp-validation-for="Photo" class="text-danger"></span>

                    <small class="text-muted d-block mt-2">未重新上傳照片時，會保留原封面。</small>

                    <div id="photoPreview" class="preview-grid">
                        @if (!string.IsNullOrWhiteSpace(Model.ExistingPhotoUrl))
                        {
                            <div class="preview-item">
                                <img src="@Model.ExistingPhotoUrl" alt="活動原封面" />
                            </div>
                        }
                    </div>

                    <div id="photoEmpty" class="preview-empty" style="display:@(string.IsNullOrWhiteSpace(Model.ExistingPhotoUrl) ? "flex" : "none");">
                        請上傳一張活動照片
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-warning w-100">更新活動</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
    $(function() {
        @* 取得jQuery物件 *@
        const $photoInput = $("#PhotoInput");
        const $previewWrap = $("#photoPreview");
        const $previewEmpty = $("#photoEmpty");

        $photoInput.on("change", function() {
            @*清空之前的預覽內容 *@
            $previewWrap.empty();

            const file = this.files && this.files[0];

            @* 檢查是否有檔案且為圖片 *@
            if (!file || !file.type.startsWith("image/")) {
                $previewEmpty.show().css("display", "flex"); 
                return;
            }

            @* 隱藏預設提示 *@
            $previewEmpty.hide();

            const reader = new FileReader();
            reader.onload = function(e) {
                @* 動態產生htnl結構 *@
                const $item = $("<div>").addClass("preview-item");
                const $img = $("<img>").attr("src", e.target.result);

                $item.append($img);
                $previewWrap.append($item);
            };
            reader.readAsDataURL(file);
        });

        @* 當輸入框失去焦點時，自動修剪前後空白 *@
        $('input[type="text"], textarea').on('blur', function () {
            $(this).val($.trim($(this).val()));
        });
    });
    </script>
}