@{
    ViewData["Title"] = "文章管理 - SweetStack";
}

<style>
    /* 核心主色調與背景 */
    :root {
        --ss-orange: #F29F33;
        --ss-light-orange: #FFF4E6;
        --ss-dark: #4A4A4A;
        --ss-gray: #757575;
    }

    body { background-color: var(--ss-bg); font-family: "PingFang TC", "Microsoft JhengHei", sans-serif; }

    .admin-container {
        max-width: 1600px;
        width: 96%;
        margin: 30px auto;
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 20px;
    
        /* 不要用固定 height，改用 min-height */
        min-height: 80vh; 
        height: auto; 
    
        /* 確保容器可以撐開下方元素 */
        margin-bottom: 50px;
    }

    @@media (min-width: 1800px) {
        .admin-container {
            max-width: 1800px;
            grid-template-columns: 350px 1fr;
        }
    }

    /* 左側列表區 */
    .post-sidebar {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
    
        /* 讓側邊欄高度固定在視窗高度，內容過多時內部滾動 */
        position: sticky;
        top: 20px;
        height: calc(100vh - 40px);
    }

    .sidebar-header {
        padding: 20px;
        background: var(--ss-orange);
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .post-list {
        overflow-y: auto;
        flex-grow: 1;
    }

    .post-item {
        padding: 15px 20px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        transition: 0.3s;
    }

    .post-item:hover { background-color: var(--ss-light-orange); }
    .post-item.active { border-left: 5px solid var(--ss-orange); background-color: var(--ss-light-orange); }

    .post-item-title { font-weight: bold; color: var(--ss-dark); margin-bottom: 5px; }
    .post-item-info { font-size: 0.85rem; color: var(--ss-gray); display: flex; justify-content: space-between; }

    /* 右側編輯區 */
    .editor-main {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
        padding: 40px 60px;
    
        /* 移除任何固定高度設定，改為 auto */
        height: auto; 
        min-height: 100%;
    }

    .editor-header {
        border-bottom: 2px solid var(--ss-light-orange);
        margin-bottom: 25px;
        padding-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .input-title {
        border: none;
        font-size: 2rem;
        font-weight: bold;
        width: 100%;
        color: var(--ss-dark);
        outline: none;
    }

    .input-title::placeholder { color: #ccc; }

    .editor-toolbar {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
    }

    .ss-select {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 5px 15px;
        color: var(--ss-gray);
    }

    .input-content {
        min-height: 400px; /* 給內容區一個基礎高度 */
        overflow-y: visible; /* 讓文字撐開高度 */
        height: auto;
    }

    /* 按鈕樣式 */
    .btn-ss-save {
        background: var(--ss-orange);
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 25px;
        font-weight: bold;
        transition: 0.3s;
    }

    .btn-ss-save:hover { background: #e08e22; transform: translateY(-2px); }

    .btn-ss-delete {
        background: #fff;
        color: #ff6b6b;
        border: 1px solid #ff6b6b;
        padding: 8px 20px;
        border-radius: 25px;
        margin-right: 10px;
    }

    .btn-ss-delete:hover { background: #ff6b6b; color: white; }

    .status-badge {
        font-size: 12px;
        padding: 2px 10px;
        border-radius: 10px;
        background: #eee;
    }

    .published { background: #e6f4ea; color: #1e7e34; }

    /* 圖片上傳區塊樣式 */
    .image-section {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 2px solid var(--ss-light-orange);
    }

    .upload-dropzone {
        border: 2px dashed #ddd;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        color: var(--ss-gray);
        cursor: pointer;
        transition: 0.3s;
        background: #fafafa;
    }

    .upload-dropzone:hover {
        border-color: var(--ss-orange);
        background: var(--ss-light-orange);
        color: var(--ss-orange);
    }

    /* 圖片預覽網格 */
    .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .image-item {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        border: 2px solid transparent;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .image-item.is-cover {
        border-color: var(--ss-orange);
    }

    .image-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* 封面標籤 */
    .cover-badge {
        position: absolute;
        top: 5px;
        left: 5px;
        background: var(--ss-orange);
        color: white;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 5px;
    }

    /* 圖片操作按鈕 (隱藏，滑過顯示) */
    .image-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 8px;
        opacity: 0;
        transition: 0.3s;
    }

    .image-item:hover .image-overlay {
        opacity: 1;
    }

    .btn-img-action {
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 15px;
        border: none;
        cursor: pointer;
        width: 80%;
    }

    .btn-set-cover { background: white; color: var(--ss-dark); }
    .btn-del-img { background: #ff6b6b; color: white; }
</style>

<div id="app">
    <div class="admin-container">
    <aside class="post-sidebar">
        <div class="sidebar-header">
            <h5 class="m-0">我的貼文</h5>
            <button class="btn btn-sm btn-light rounded-circle" v-on:click="addNewPost()">＋</button>
        </div>
        <div class="post-list" id="postSideList">
            <div v-for="item in posts" :key="item.postId"
                :class="['post-item', { active: currentPost.postId === item.postId }]"
                v-on:click="getPostDetail(item.postId)">
                <div class="post-item-title">{{ item.title || '無標題貼文' }}</div>
                <div class="post-item-info">
                    <span>{{ item.date }}</span>
                    <span :class="['status-badge', { published: item.isPublished }]">
                        {{ item.isPublished ? '已發布' : '草稿' }}
                        </span>
                </div>
            </div>
            <div v-if="posts.length === 0" class="p-3 text-muted text-center">
                    尚無貼文
                </div>
        </div>
    </aside>

    <input type="hidden" id="PostId" value="0" />
    <main class="editor-main">
        <div class="editor-header">
            <input type="text" class="input-title" id="postTitle" v-model="currentPost.title" placeholder="輸入迷人的標題...">
            <div class="status-indicator">
                <span id="saveStatus" class="text-muted" style="font-size: 12px;">{{ saveStatus }}</span>
            </div>
        </div>

        <div class="editor-toolbar"> 
            <div class="form-check form-switch mt-1">
                <input class="form-check-input" type="checkbox" id="isPublished" v-model="currentPost.isPublished">
                <label class="form-check-label" for="isPublished">公開發布</label>
            </div>
        </div>

        <textarea class="input-content" id="postContent" v-model="currentPost.content" placeholder="分享你的烘焙故事..."></textarea>
        <section class="image-section">
            <label class="fw-bold mb-2" style="color: var(--ss-dark);">貼文圖片 (最多 1 張)</label>
    
            <div class="upload-dropzone" id="dropzone" v-on:click="$refs.fileInput.click()">
                <i class="bi bi-cloud-upload" style="font-size: 2rem;"></i>
                <p class="m-0">點擊或將圖片拖曳至此處上傳</p>
                <span style="font-size: 12px; color: #999;">建議尺寸: 1200x800px (JPG, PNG)</span>
                <input type="file" id="fileInput" ref="fileInput" hidden multiple accept="image/*" v-on:change="imageChange">
            </div>

            <div class="image-grid" id="imageGrid">
                <div v-for="(img, index) in previewImages" :key="index" class="image-item is-cover">
                    <span class="cover-badge">封面圖預覽</span>
                        <img :src="img.url" alt="預覽圖">
                        <div class="image-overlay">
                            <button type="button" class="btn-img-action btn-del-img" v-on:click="removeImgPreview">刪除圖片</button>
                        </div>
                </div>
            </div>
        </section>
        <div class="editor-footer d-flex justify-content-end mt-4">
            <button class="btn-ss-delete" v-on:click="deletePost" v-if="currentPost.postId !== 0">刪除文章</button>
            <button class="btn-ss-save" v-on:click="savePost()" :disabled="isSaving">{{ isSaving ? '儲存中...' : '確認儲存' }}</button>
        </div>
    </main>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const app = Vue.createApp({
            data(){
                return{
                    posts:[],
                    saveStatus: '已就緒',
                    isSaving: false,
                    currentPost:{
                        postId: 0,
                        title:'',
                        content:'',
                        isPublished: true,
                        postTypeId: 0,
                        coverImgName: ''
                    },
                    previewImages:[]
                }
            },
            methods:{
                // 側邊欄取得文章列表
                async getPostList(){
                    try{
                        const res = await fetch("/PostArticle/GetPostList");
                        this.posts = await res.json();
                    }catch(error){
                        console.error("取得文章列表失敗:", error);
                    }
                },
                // 點擊側邊欄文章，取得文章詳細內容
                async getPostDetail(id){
                    try{
                        this.saveStatus = '載入中...';
                        const res = await fetch(`/PostArticle/GetPostDetail?id=${id}`);
                        const data = await res.json();
                        this.currentPost = {
                            postId: data.postId,
                            title: data.title,
                            content: data.content,
                            isPublished: data.isPublished,
                            postTypeId: data.postTypeId || 0
                        };
                        this.previewImages = data.imageUrl? [{url: data.imageUrl, name: 'current'}]:[];
                        this.saveStatus = '已自動儲存';
                    }catch(error){
                        console.error("取得文章內容失敗:", error);
                    }
                },
                // 新增文章
                addNewPost(){
                    this.currentPost = { postId: 0, title: '', content: '', isPublished: true };
                    this.previewImages = [];
                    this.$refs.fileInput.value = ''; // 清空檔案輸入框
                    this.saveStatus = '新文章';
                },
                // 圖片選取跟預覽
                imageChange(e){
                    const file = e.target.files[0];
                    if(!file) return;

                    this.currentPost.coverImgName = file.name;

                    const reader = new FileReader();
                    reader.onload = (event) => {
                        this.previewImages = [{ url: event.target.result, name: file.name }];
                    };
                    reader.readAsDataURL(file);
                },
                // 刪除預覽圖片
                removeImgPreview(){
                    this.previewImages = [];
                    this.$refs.fileInput.value = ''; // 清空檔案輸入框
                    this.currentPost.coverImgName = '';
                },
                // 儲存文章
                async savePost(){
                    if(!this.currentPost.title.trim()){
                        Swal.fire('提醒', '標題不能空白喔！', 'warning');
                        return;
                    }

                    this.isSaving = true;
                    const formData = new FormData();
                    formData.append("PostId", this.currentPost.postId || 0);
                    formData.append("PostTypeId", this.currentPost.postTypeId || 0);
                    formData.append("Title", this.currentPost.title);
                    formData.append("Content", this.currentPost.content);
                    formData.append("IsPublished", this.currentPost.isPublished);
                    formData.append("CoverImgName", this.currentPost.coverImgName || "");
                    const file = this.$refs.fileInput.files[0];
                    if(file){
                        formData.append("Images", file);
                    }

                    try{
                        const res = await fetch("/PostArticle/UpdateInsertPost",{
                            method:'POST',
                            body:formData
                            //圖片是二進位檔，需要使用formData
                            //formData瀏覽器會自動設定 Content-Type 為 multipart/form-data，且包含正確的 boundary，所以「不要」手動設定 headers
                        })
                        const result = await res.json();
                        if(res.ok){
                            Swal.fire({ icon: 'success', title: result.message, timer: 1500, showConfirmButton: false });
                            this.currentPost.postId = result.newPostId;
                            this.getPostList();
                        }
                    }catch(error){
                        Swal.fire('錯誤', '儲存失敗，請稍後再試', 'error');
                    }finally{
                        this.isSaving = false;
                    }
                },
                async deletePost(){
                    const result = await Swal.fire({
                        title: '確定要刪除嗎？',
                        text: "刪除後無法還原喔！",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#F29F33',
                        cancelButtonColor: '#d33',
                        confirmButtonText: '確定刪除',
                        cancelButtonText: '取消'
                    });

                    if(result.isConfirmed){
                        try{
                            const res = await fetch(`/PostArticle/DeletePost?id=${this.currentPost.postId}`,{
                                method:'POST'
                            });
                            const result = await res.json();

                            if(result.success){
                                Swal.fire('已刪除', '文章已成功移除', 'success');
                                this.addNewPost();
                                this.getPostList();
                            }else{
                                Swal.fire('錯誤', result.message, 'error');
                            }
                        }
                        catch(error){
                            console.error("刪除失敗:", error);
                            Swal.fire('錯誤', '系統連線異常', 'error');
                        }
                    }
                }
            },
            mounted(){
                this.getPostList();
            }
        }).mount('#app');
    </script>
}