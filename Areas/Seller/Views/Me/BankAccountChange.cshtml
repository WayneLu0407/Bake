@model Bake.Areas.Seller.Model.BankAccountChangeModel
@{
	ViewBag.Title = "變更收款帳戶";
}

<div class="row px-5">
	<div class="col-12 py-5">
		<h2>變更收款帳戶</h2>
	</div>
	<div class="col-12 bg-white p-5">
		<form asp-area="Seller" asp-controller="Me" asp-action="BankAccountChange" method="post">
			<div class="row">
				<div class="col-6">
					<div class="input-style-1">
						<label> 銀行帳號</label>
						<input asp-for="BankAccount" type="text" placeholder="007-1234567890" />
						<span asp-validation-for="BankAccount" class="text-danger"></span>
					</div>
				</div>
				<div class="col-12 mt-3">
					<button type="submit" class="main-btn primary-btn btn-hover text-center" style="width: 150px;">
						變更
					</button>
				</div>
			</div>
		</form>
	</div>
</div>