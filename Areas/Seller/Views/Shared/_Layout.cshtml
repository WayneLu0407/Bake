<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="assets/images/favicon.svg" type="image/x-icon" />
    <title>@ViewData["Title"] </title>

    <!-- ========== All CSS files linkup ========= -->
    <link rel="stylesheet" href="~/seller_assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/seller_assets/css/lineicons.css" />
    <link rel="stylesheet" href="~/seller_assets/css/quill/bubble.css" />
    <link rel="stylesheet" href="~/seller_assets/css/quill/snow.css" />
    <link rel="stylesheet" href="~/seller_assets/css/fullcalendar.css" />
    <link rel="stylesheet" href="~/seller_assets/css/morris.css" />
    <link rel="stylesheet" href="~/seller_assets/css/datatable.css" />
    <link rel="stylesheet" href="~/seller_assets/css/main.css" />
    <link rel="stylesheet" href="~/seller_assets/css/sweetstack-admin-override.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <!-- ========== All JQuery files linkup ========= -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>

