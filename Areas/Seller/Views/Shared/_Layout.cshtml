                        <li>
                            <a asp-area="Seller" asp-controller="Me" asp-action="Settings"> 個人資訊 </a>
                        </li>
                        @if (!User.IsInRole("Seller"))
                        {
                            <li>
                                <a asp-area="Seller" asp-controller="Me" asp-action="SwitchSeller"> 我想成為賣家 </a>
                            </li>
                        }
                        @if (User.IsInRole("Seller"))
                        {
                            <li>
                                <a asp-area="Seller" asp-controller="Me" asp-action="BankAccountChange"> 變更收款帳戶 </a>
                            </li>
                        }
                    </ul>
                </li>
                <li class="nav-item">
                    <a asp-area="Seller" asp-controller="Me" asp-action="Orders">
