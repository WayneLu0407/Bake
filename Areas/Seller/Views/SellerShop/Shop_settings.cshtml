@model Bake.Areas.Seller.ViewModels.SellerShopSettingsReadViewModel

@{
    ViewData["Title"] = "Shop_settings";

    string shopImageUrl = Url.Content("~/ProductPicture/NoImage.jpg");

    if (!string.IsNullOrWhiteSpace(Model?.ShopImg))
    {
        if (Model.ShopImg.StartsWith("http://") || Model.ShopImg.StartsWith("https://"))
        {
            shopImageUrl = Model.ShopImg;
        }
        else
        {
            shopImageUrl = Url.Content("~/" + Model.ShopImg.TrimStart('/'));
        }
    }
}

<div class="container my-4">
    <div class="row g-4">

        <!-- 右側內容 -->
        <div class="col-12">
            <div class="seller-panel p-4 rounded-4">

                <div class="mb-3">
                    <div class="fs-4 fw-bold">店舖設定</div>
                </div>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success py-2 px-3 mb-0">
                        @TempData["SuccessMessage"]
                    </div>
                }
                <div class="seller-card bg-white rounded-4 p-4 shadow-sm">
                    <form asp-area="Seller" asp-controller="SellerShop" asp-action="Shop_settings" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <!-- 頭像 + 店名 + 簡介 -->
                        <div class="d-flex gap-4 align-items-start flex-wrap flex-md-nowrap">

                            <div class="flex-shrink-0">
                                @* //顯示目前店鋪頭像 *@
                                <div class="seller-avatar bg-secondary-subtle align-items-center justify-content-center overflow-hidden mb-2"
                                     style="width: 140px; height: 140px; border-radius: 16px;">
                                    <img id="shopImagePreview"
                                         src="@shopImageUrl"
                                         alt="店舖圖片"
                                         style="width:100%; height:100%; object-fit:cover;"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/ProductPicture/NoImage.jpg")';" />
                                </div>

                                <input asp-for="ShopImageFile"
                                       type="file"
                                       class="form-control form-control-sm"
                                       accept=".jpg,.jpeg,.png,.webp" />
                                <span asp-validation-for="ShopImageFile" class="text-danger"></span>
                                <div>
                                    <div class="mb-3 w-50">
                                        <label asp-for="StatusId" class="form-label font-weight-bold">商店營業狀態</label>
        
                                        @* 使用 Model 中的 StatusOptions，即使報錯也不會消失 *@
                                        <select asp-for="StatusId"
                                                class="form-select border-warning"
                                                asp-items="Model.StatusName">
                                        </select>
                                        
   
                                    </div>
                                    <span asp-validation-for="StatusId" class="text-danger"></span>
                                </div>
                            </div>
                            

                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="mb-3">
                                    <label asp-for="ShopName" class="form-label fw-bold"></label>
                                    <input asp-for="ShopName" class="form-control form-control-lg fw-bold" />
                                    <span asp-validation-for="ShopName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ShopDescription" class="form-label fw-bold"></label>
                                    <textarea asp-for="ShopDescription" class="form-control" rows="4"></textarea>
                                    <span asp-validation-for="ShopDescription" class="text-danger"></span>
                                </div>
                                
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label asp-for="FacebookUrl" class="form-label"></label>
                            <input asp-for="FacebookUrl" class="form-control" placeholder="https://facebook.com/..." />
                            <span asp-validation-for="FacebookUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InstagramUrl" class="form-label"></label>
                            <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/..." />
                            <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="YoutubeUrl" class="form-label"></label>
                            <input asp-for="YoutubeUrl" class="form-control" placeholder="https://youtube.com/..." />
                            <span asp-validation-for="YoutubeUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PinterestUrl" class="form-label"></label>
                            <input asp-for="PinterestUrl" class="form-control" placeholder="https://pinterest.com/..." />
                            <span asp-validation-for="PinterestUrl" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button"
                                    id="openShopPreviewBtn"
                                    class="btn btn-warning px-4">預覽</button>
                            <button type="submit" class="btn btn-warning px-4">儲存</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="shopPreviewModal" tabindex="-1" aria-labelledby="shopPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title" id="shopPreviewModalLabel">店鋪預覽</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="shopPreviewModalBody">
                <div class="text-muted">載入預覽中...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            const defaultImage = '@shopImageUrl';

            $("#ShopImageFile").on("change", function (e) {
                const file = e.target.files && e.target.files[0];
                if (!file) {
                    $("#shopImagePreview").attr("src", defaultImage);
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (evt) {
                    $("#shopImagePreview").attr("src", evt.target.result);
                };
                reader.readAsDataURL(file);
            });

            function escapeHtml(value) {
                return (value || "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#39;");
            }

            function socialIcon(url, iconClass) {
                if (!url) return "";
                return `
                    <a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" class="social-icon">
                        <i class="${iconClass}"></i>
                    </a>
                `;
            }

            $("#openShopPreviewBtn").on("click", function () {
                const shopName = ($("#ShopName").val() || "").trim() || "未填寫店鋪名稱";
                const shopDescriptionRaw = ($("#ShopDescription").val() || "").trim();
                const shopDescription = shopDescriptionRaw
                    ? escapeHtml(shopDescriptionRaw).replace(/\n/g, "<br>")
                    : "尚未填寫店鋪介紹";

                const imageUrl = $("#shopImagePreview").attr("src") || defaultImage;

                const facebookUrl = ($("#FacebookUrl").val() || "").trim();
                const instagramUrl = ($("#InstagramUrl").val() || "").trim();
                const youtubeUrl = ($("#YoutubeUrl").val() || "").trim();
                const pinterestUrl = ($("#PinterestUrl").val() || "").trim();

                const iconsHtml = [
                    socialIcon(facebookUrl, "fa-brands fa-facebook"),
                    socialIcon(instagramUrl, "fa-brands fa-instagram"),
                    socialIcon(pinterestUrl, "fa-brands fa-pinterest"),
                    socialIcon(youtubeUrl, "fa-brands fa-youtube")
                ].filter(Boolean).join("");

                const shareBlock = iconsHtml
                    ? `
                        <div class="d-flex align-items-center gap-3">
                            <span class="fw-bold me-1">分享</span>
                            <div class="d-flex flex-wrap gap-2">
                                ${iconsHtml}
                            </div>
                        </div>
                    `
                    : "";

                $("#shopPreviewModalBody").html(`
                    <div class="bg-white rounded-4 shadow-sm p-4 mb-0">
                        <div class="d-flex flex-column flex-md-row gap-4 align-items-start">
                            <div class="flex-shrink-0">
                                <div class="bg-secondary-subtle d-flex align-items-center justify-content-center overflow-hidden"
                                     style="width: 140px; height: 140px; border-radius: 16px;">
                                    <img src="${imageUrl}"
                                         alt="店舖圖片"
                                         style="width:100%; height:100%; object-fit:cover;" />
                                </div>
                            </div>

                            <div class="flex-grow-1 w-100" style="min-width:0;">
                                <h3 class="fw-bold mb-3">${escapeHtml(shopName)}</h3>
                                <p class="text-muted mb-4" style="line-height:1.9;">${shopDescription}</p>
                                ${shareBlock}
                            </div>
                        </div>
                    </div>
                `);

                const modal = new bootstrap.Modal(document.getElementById("shopPreviewModal"));
                modal.show();
            });
        });
    </script>
}
