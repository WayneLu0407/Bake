@model Bake.Areas.Seller.ViewModels.SellerShopSettingsReadViewModel

@{
    ViewData["Title"] = "Shop_settings";

    string? shopImageUrl = null;

    if (!string.IsNullOrWhiteSpace(Model?.ShopImg) &&
        !Model.ShopImg.StartsWith("http://") &&
        !Model.ShopImg.StartsWith("https://"))
    {
        shopImageUrl = Url.Content("~/" + Model.ShopImg.TrimStart('/'));
    }

    int? currentUserId = ViewBag.CurrentUserId as int?;
    bool hasShop = ViewBag.HasShop is bool b && b;
}

<div class="container my-4">
    <div class="row g-4">

        <!-- 右側內容 -->
        <div class="col-12">
            <div class="seller-panel p-4 rounded-4">

                <div class="mb-3">
                    <div class="fs-4 fw-bold">店舖設定</div>
                </div>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success py-2 px-3 mb-0">
                        @TempData["SuccessMessage"]
                    </div>
                }
                <div class="seller-card bg-white rounded-4 p-4 shadow-sm">
                    <form id="shopSettingsForm" asp-area="Seller" asp-controller="SellerShop" asp-action="Shop_settings" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <!-- 頭像 + 店名 + 簡介 -->
                        <div class="d-flex gap-4 align-items-start flex-wrap flex-md-nowrap">

                            <div class="flex-shrink-0">
                                @* //顯示目前店鋪頭像 *@
                                <div class="seller-avatar bg-secondary-subtle align-items-center justify-content-center overflow-hidden mb-2"
                                     style="width: 140px; height: 140px; border-radius: 16px;">
                                    <img id="shopImagePreview"
                                         src="@shopImageUrl"
                                         alt="店舖圖片"
                                         style="width:100%; height:100%; object-fit:cover;"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/ProductPicture/NoImage.jpg")';" />
                                </div>

                                <input asp-for="ShopImageFile"
                                       type="file"
                                       class="form-control form-control-sm"
                                       accept=".jpg,.jpeg,.png,.webp" />
                                <span asp-validation-for="ShopImageFile" class="text-danger"></span>
                                <div>
                                    <div class="mb-3 w-50">
                                        <label asp-for="StatusId" class="form-label font-weight-bold">商店營業狀態</label>
        
                                        @* 使用 Model 中的 StatusOptions，即使報錯也不會消失 *@
                                        <select asp-for="StatusId"
                                                class="form-select border-warning"
                                                asp-items="Model.StatusName">
                                        </select>
                                        
   
                                    </div>
                                    <span asp-validation-for="StatusId" class="text-danger"></span>
                                </div>
                            </div>
                            

                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="mb-3">
                                    <label asp-for="ShopName" class="form-label fw-bold"></label>
                                    <input asp-for="ShopName" class="form-control form-control-lg fw-bold" />
                                    <span asp-validation-for="ShopName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ShopDescription" class="form-label fw-bold"></label>
                                    <textarea asp-for="ShopDescription" class="form-control" rows="4"></textarea>
                                    <span asp-validation-for="ShopDescription" class="text-danger"></span>
                                </div>
                                
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label asp-for="FacebookUrl" class="form-label"></label>
                            <input asp-for="FacebookUrl" class="form-control" placeholder="https://facebook.com/..." />
                            <span asp-validation-for="FacebookUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InstagramUrl" class="form-label"></label>
                            <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/..." />
                            <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="YoutubeUrl" class="form-label"></label>
                            <input asp-for="YoutubeUrl" class="form-control" placeholder="https://youtube.com/..." />
                            <span asp-validation-for="YoutubeUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PinterestUrl" class="form-label"></label>
                            <input asp-for="PinterestUrl" class="form-control" placeholder="https://pinterest.com/..." />
                            <span asp-validation-for="PinterestUrl" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            @if (hasShop && currentUserId.HasValue)
                                {
                                <a href="@Url.Content($"~/Shop/{currentUserId.Value}")" class="btn btn-outline-warning px-4">我的店鋪</a>
                                }
                                else
                                {
                                <button type="button" class="btn btn-outline-secondary px-4 disabled">我的店鋪</button>
                                }
                            <button id="saveShopBtn" type="submit" class="btn btn-warning px-4" disabled>儲存</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

@* <div class="modal fade" id="shopPreviewModal" tabindex="-1" aria-labelledby="shopPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title" id="shopPreviewModalLabel">店鋪預覽</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="shopPreviewModalBody">
                <div class="text-muted">載入預覽中...</div>
            </div>
        </div>
    </div>
</div> *@

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            const $form = $("#shopSettingsForm");
            const $saveBtn = $("#saveShopBtn");

            function getFormSnapshot() {
                const snapshot = {};

                $form.find("input, textarea, select").each(function () {
                    const $field = $(this);
                    const name = $field.attr("name");
                    if (!name) return;

                    const type = ($field.attr("type") || "").toLowerCase();

                    if (type === "file") {
                        snapshot[name] = this.files && this.files.length > 0
                            ? Array.from(this.files).map(f => `${f.name}_${f.size}_${f.lastModified}`).join("|")
                            : "";
                        return;
                    }

                    if (type === "checkbox" || type === "radio") {
                        snapshot[name] = $field.prop("checked");
                        return;
                    }

                    snapshot[name] = $field.val() ?? "";
                });

                return snapshot;
            }

            function isSameSnapshot(a, b) {
                const aKeys = Object.keys(a);
                const bKeys = Object.keys(b);

                if (aKeys.length !== bKeys.length) return false;

                for (const key of aKeys) {
                    if (a[key] !== b[key]) return false;
                }

                return true;
            }

            function setSaveButtonState(isDirty) {
                $saveBtn.prop("disabled", !isDirty);

                if (isDirty) {
                    $saveBtn
                        .removeClass("btn-secondary")
                        .addClass("btn-warning");
                } else {
                    $saveBtn
                        .removeClass("btn-warning")
                        .addClass("btn-secondary");
                }
            }

            const initialSnapshot = getFormSnapshot();

            function refreshDirtyState() {
                const currentSnapshot = getFormSnapshot();
                const isDirty = !isSameSnapshot(initialSnapshot, currentSnapshot);
                setSaveButtonState(isDirty);
            }

            $form.on("input change", "input, textarea, select", function () {
                refreshDirtyState();
            });

            refreshDirtyState();
        });
    </script>
}